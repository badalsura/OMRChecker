# Any directory starting with a dot
**/\.*/
# Except .github
!.github/

# Everything in inputs/ and outputs/
inputs/*
outputs/*

# Misc
**/.DS_Store
**/__pycache__
venv/
OMRChecker.wiki/
.coverage

# Trained models and exported datasets stay out of git
models/
datasets/
*.onnx
omr_data/

web/omr-browser/node_modules/

# OCR models fetched at build time (packaging/fetch_ocr_models.py)
packaging/tessdata/
packaging/ocr_build.json
packaging/models/
packaging/tesseract/
packaging/cloudflared/
packaging/ocr-models.zip

# Licensing: never commit private keys or issued license files
license-keys/
*.omrlic
private_key.pem
src/licensing/public_key.pem
.license_state
